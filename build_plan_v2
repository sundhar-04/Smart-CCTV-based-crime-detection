### 1.2 — Database Schema

```sql
-- alerts: mirrors existing alerts.chain.jsonl structure
CREATE TABLE alerts (
    id TEXT PRIMARY KEY,
    entity TEXT,
    camera TEXT,
    zone TEXT,
    score REAL,
    types TEXT,          -- JSON array
    reasons TEXT,        -- JSON array
    status TEXT DEFAULT 'PENDING_CONFIRMATION',
    -- PENDING_CONFIRMATION | CONFIRMED | DISMISSED | SUPPRESSED_BY_BUDGET | EXPIRED
    dismiss_reason TEXT,
    dispatch_channels TEXT,  -- JSON array
    clip_path TEXT,
    clip_sha256 TEXT,
    best_shot_path TEXT,
    global_id TEXT,
    created_at TIMESTAMP,
    decided_at TIMESTAMP,
    decided_by TEXT
);

-- cameras: registered camera sources
CREATE TABLE cameras (
    id TEXT PRIMARY KEY,
    name TEXT,
    zone TEXT,
    source TEXT,          -- RTSP URL or file path
    status TEXT DEFAULT 'offline',
    map_x REAL,
    map_y REAL,
    config TEXT           -- JSON blob (zones, params)
);

-- analysis_jobs: on-demand video analysis
CREATE TABLE analysis_jobs (
    id TEXT PRIMARY KEY,
    status TEXT DEFAULT 'queued',  -- queued | processing | done | error
    source_filename TEXT,
    source_path TEXT,
    progress_pct REAL DEFAULT 0,
    frames_done INTEGER DEFAULT 0,
    frames_total INTEGER DEFAULT 0,
    peak_score REAL DEFAULT 0,
    threshold REAL,
    zones TEXT,           -- JSON (user-drawn zones, if any)
    result_alert_ids TEXT, -- JSON array
    error_message TEXT,
    created_at TIMESTAMP,
    completed_at TIMESTAMP
);

-- settings: key-value config store
CREATE TABLE settings (
    key TEXT PRIMARY KEY,
    value TEXT,           -- JSON
    updated_at TIMESTAMP,
    updated_by TEXT
);

-- audit_log: append-only
CREATE TABLE audit_log (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    action TEXT,
    user_name TEXT,
    object_type TEXT,
    object_id TEXT,
    detail TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
```

